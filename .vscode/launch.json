{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CatalogApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/CatalogApi/bin/Debug/net8.0/CatalogApi.dll",
      "cwd": "${workspaceFolder}/src/CatalogApi",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5099"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
